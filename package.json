{
  "name": "@aron98/load-lock",
  "version": "1.3.0",
  "description": "Machine-wide counting semaphore coordinating resource-intensive work across parallel coding agents (OpenCode, Codex CLI, Claude Code, ...)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aron98/load-lock.git"
  },
  "bugs": {
    "url": "https://github.com/aron98/load-lock/issues"
  },
  "homepage": "https://github.com/aron98/load-lock#readme",
  "keywords": [
    "coding-agent",
    "agent-coordination",
    "mcp",
    "opencode",
    "codex",
    "claude-code",
    "semaphore",
    "resource-management",
    "build"
  ],
  "bin": {
    "load-lock": "dist/cli/main.js",
    "load-lock-mcp": "dist/mcp/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/adapters/opencode/plugin.d.ts",
      "default": "./dist/adapters/opencode/plugin.js"
    },
    "./shared/client": {
      "types": "./dist/shared/client.d.ts",
      "default": "./dist/shared/client.js"
    },
    "./shared/client.js": {
      "types": "./dist/shared/client.d.ts",
      "default": "./dist/shared/client.js"
    },
    "./shared/protocol": {
      "types": "./dist/shared/protocol.d.ts",
      "default": "./dist/shared/protocol.js"
    },
    "./shared/protocol.js": {
      "types": "./dist/shared/protocol.d.ts",
      "default": "./dist/shared/protocol.js"
    },
    "./policy/text": {
      "types": "./dist/policy/text.d.ts",
      "default": "./dist/policy/text.js"
    },
    "./policy/text.js": {
      "types": "./dist/policy/text.d.ts",
      "default": "./dist/policy/text.js"
    },
    "./mcp/server": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    },
    "./mcp/server.js": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    },
    "./core/daemon": {
      "types": "./dist/core/daemon.d.ts",
      "default": "./dist/core/daemon.js"
    },
    "./core/daemon.js": {
      "types": "./dist/core/daemon.d.ts",
      "default": "./dist/core/daemon.js"
    },
    "./tui": {
      "types": "./dist/adapters/opencode/tui.d.ts",
      "default": "./dist/adapters/opencode/tui.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "demo",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode/plugin": "^2.0.29",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "2.0.29",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  }
}
