# syntax=docker/dockerfile:1
# load-lock harness-verification image.
#
# Stage 1 (builder): build load-lock from the LOCAL source tree and pack a
# tarball, so container verification always tests the code in this repo.
# Stage 2 (harness): Node + one coding-agent harness + load-lock installed
# globally, with the load-lock integration already wired into the image's
# HOME (disposable - the host's ~/.codex / ~/.claude are never touched).
#
# Build:
#   sudo docker build -f docker/Dockerfile.harness --build-arg HARNESS=codex \
#            -t load-lock-verify:codex .
#   sudo docker build -f docker/Dockerfile.harness --build-arg HARNESS=claude-code \
#            -t load-lock-verify:claude-code .
#   docker build -f docker/Dockerfile.harness --build-arg HARNESS=claude-code \
#            --build-arg LOAD_LOCK_GLOBAL=0 -t load-lock-verify:claude-code-plugin .
# (sudo only where plain docker cannot reach the daemon; docker/run-*.sh
# decide that themselves, see docker/docker-cmd.sh.)
#
# LOAD_LOCK_GLOBAL=0 (#104, claude-code only) builds a clean-machine image:
# no global load-lock and no `load-lock install`; the packed tarball stays
# in /pkg and this repo's plugin marketplace is copied to /opt/load-lock-repo
# for verify-claude-code.sh's plugin mode (MODE=plugin).
#
# The container is self-contained: the load-lock daemon auto-spawns inside it
# (daemon and harness must share a PID namespace for /proc-based process
# tracking - that is the whole point of one container per run).

FROM node:24-bookworm-slim AS builder
WORKDIR /src
COPY package.json package-lock.json tsconfig.json ./
# scripts/shrinkwrap.mjs runs as npm's prepack hook (npm-shrinkwrap.json, #103)
COPY scripts ./scripts
COPY src ./src
# skills/ ships in the package ("files") and load-lock install copies
# skills/load-lock/SKILL.md into the harness — without this COPY the packed
# tarball lacks it and `load-lock install --harness claude-code` dies on ENOENT.
COPY skills ./skills
RUN npm ci && npm run build && npm pack

FROM node:24-bookworm-slim AS harness
ARG HARNESS=codex
ARG LOAD_LOCK_GLOBAL=1
ENV HARNESS=${HARNESS}
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git procps python3 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /pkg
COPY --from=builder /src/*.tgz ./
# codex is version-pinned for reproducible verification; bump deliberately.
# Exec mode never injects MCP tools at 0.16x (upstream bug, openai/codex#38689);
# the interactive TUI path plus docker/codex-api-shim.js handle it (see
# docker/verify-codex.sh for the full story).
RUN { [ "$LOAD_LOCK_GLOBAL" = 0 ] || npm install -g ./*.tgz; } \
 && case "$HARNESS" in \
      codex)        npm install -g @openai/codex@0.163.0 ;; \
      # --allow-scripts: npm 11 blocks package postinstall scripts by default;
      # claude-code's install.cjs sets up bundled ripgrep + platform files and
      # the CLI is unreliable without it.
      claude-code)  npm install -g --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code ;; \
      *) echo "unknown HARNESS: $HARNESS" >&2; exit 64 ;; \
    esac \
 && mkdir -p /workspace

# Seed harness config BEFORE the load-lock installer so the installer only
# appends its MCP entry to the existing provider config.
COPY docker/seed/codex-config.toml /tmp/seed/codex-config.toml
# Claude Code refuses --dangerously-skip-permissions when running as root, so
# the claude container runs as the unprivileged "node" user (uid 1000, shipped
# by the official node image) and the integration is installed into /home/node
# (its HOME). Codex keeps using /root exactly as before. The install itself
# runs as root (build step), so the claude-code branch chowns /home/node to
# node afterwards - Claude Code rewrites ~/.claude.json at runtime and would
# hit EACCES otherwise.
RUN mkdir -p /root/.codex \
 && case "$HARNESS" in \
      codex) \
        cp /tmp/seed/codex-config.toml /root/.codex/config.toml \
        && load-lock install --harness codex ;; \
      claude-code) \
        mkdir -p /home/node/.claude \
        && chown node:node /workspace \
        && { [ "$LOAD_LOCK_GLOBAL" = 0 ] || HOME=/home/node load-lock install --harness claude-code; } \
        && chown -R node:node /home/node ;; \
    esac \
 && { [ "$LOAD_LOCK_GLOBAL" = 0 ] || load-lock doctor || true; }

# Plugin mode (#104): the marketplace root and the plugin folder exactly as
# committed (the plugin has no build step). Copied for every image; only
# MODE=plugin uses it.
COPY .claude-plugin /opt/load-lock-repo/.claude-plugin
COPY plugins/claude-code /opt/load-lock-repo/plugins/claude-code
# Owned by node: a directory marketplace is read in place, and phase 1b of
# the plugin-mode run temporarily strips the await-offer hook from it.
RUN chown -R node:node /opt/load-lock-repo

# Scenario scripts run inside the container (see docker/run-*-verify.sh).
# claude-pty.py drives the interactive TUI through a pty for the parts of
# verification that need an idle session or slash commands (/compact,
# async await-offer wake).
COPY docker/verify-codex.sh /usr/local/bin/verify-codex.sh
COPY docker/verify-claude-code.sh /usr/local/bin/verify-claude-code.sh
COPY docker/verify-claude-plugin-lib.sh /usr/local/bin/verify-claude-plugin-lib.sh
COPY docker/codex-pty.py /usr/local/bin/codex-pty.py
COPY docker/codex-api-shim.js /usr/local/bin/codex-api-shim.js
COPY docker/claude-pty.py /usr/local/bin/claude-pty.py
# Scripted stand-in for the Anthropic API (plugin mode's model-free phases).
COPY docker/anthropic-stub.mjs /usr/local/bin/anthropic-stub.mjs
RUN chmod +x /usr/local/bin/verify-*.sh /usr/local/bin/codex-pty.py /usr/local/bin/codex-api-shim.js /usr/local/bin/claude-pty.py

WORKDIR /workspace
# Scenario script is passed as the docker run command (see run-*-verify.sh).
